{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "format": "uri",
            "type": "string"
        },
        "boards": {
            "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                    "banks": {
                        "items": {
                            "additionalProperties": false,
                            "properties": {
                                "base": {
                                    "type": "integer"
                                },
                                "length": {
                                    "type": "integer"
                                }
                            },
                            "required": [
                                "base",
                                "length"
                            ],
                            "type": "object"
                        },
                        "type": "array"
                    },
                    "chip": {
                        "additionalProperties": false,
                        "properties": {
                            "family": {
                                "enum": [
                                    "esp32",
                                    "stm32"
                                ]
                            },
                            "name": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "family",
                            "name"
                        ],
                        "type": "object"
                    }
                },
                "required": [
                    "banks",
                    "chip"
                ],
                "type": "object"
            },
            "type": "object"
        }
    },
    "required": [
        "boards"
    ],
    "type": "object"
}
