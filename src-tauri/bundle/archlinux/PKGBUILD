# Maintainer: Sora Tonami <ms0503 at outlook dot com>

# shellcheck disable=SC2034

_pkgname='mechatronicslab-circuit-metadata-editor'
pkgname="${_pkgname}-git"
pkgver='0.1.0' # auto detect from src-tauri/Cargo.toml
pkgrel=1
pkgdesc='Edit metadata of circuit made by Mechatronics Lab'
arch=('x86_64')
url='https://github.com/mecha-natori/metadata-editor'
license=('MIT')
depends=(
    'cairo'
    'dbus'
    'gdk-pixbuf2'
    'glib2'
    'glibc'
    'gtk3'
    'hicolor-icon-theme'
    'libgcc'
    'libsoup3'
    'webkit2gtk-4.1'
)
makedepends=(
    'git'
    'go-yq'
    'mold'
    'nodejs'
    'pnpm'
    'rustup'
)
options=(
    '!emptydirs'
    '!strip'
)
source=("git+${url}.git")
b2sums=('SKIP')

pkgver() {
    cd ./metadata-editor || return 1
    yq '.package.version' ./src-tauri/Cargo.toml
}

prepare() {
    cd ./metadata-editor || return 1
    rustup toolchain install nightly --profile minimal
    pnpm ci
}

build() {
    cd ./metadata-editor || return 1
    pnpm tauri build -b deb
}

package() {
    cd ./metadata-editor || return 1
    # shellcheck disable=SC2154
    cp -a "./target/release/bundle/deb/${_pkgname}_${pkgver}_amd64/data/"* "${pkgdir}"
    install -Dm444 LICENSE.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
